# OpenAI (ChatGPT Business) product feed SFTP. Copy to .env and fill in; .env is gitignored.
OPENAI_FEED_SFTP_HOST=sftp-prod3.commerce.openai.com
OPENAI_FEED_SFTP_PORT=443
OPENAI_FEED_SFTP_USER=
OPENAI_FEED_SFTP_PASSWORD=
OPENAI_FEED_SFTP_PATH=/

# Optional feed tuning
# FEED_REGIONS=en,ua,pl,ro
# FEED_SLOT_MODE=summary        # or "variants": one row per open slot
# FEED_MAX_SLOTS=12
# FEED_STORE_COUNTRY=PL
